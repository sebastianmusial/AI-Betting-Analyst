<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ALTERNATYWA dla morning (nie instaluj obu): 08:00 claude -p z /morning-scout — skan + newsy + weto. Zużywa limit subskrypcji Claude, trwa kilka–kilkanaście minut.
     Szablon: __REPO__ podmienia scripts/launchd/install.sh. Instrukcja: docs/automation.md -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.betting-analyst.claude-morning</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/scripts/run_job.sh</string>
        <string>claude-morning</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/data/logs/launchd-claude-morning.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/data/logs/launchd-claude-morning.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
